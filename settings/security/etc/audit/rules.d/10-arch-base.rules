# Minimal Arch Linux audit policy focused on:
#   - persistent system modification
#   - package database changes
#   - Secure Boot / UKI boot artifact changes
#   - privileged execution
#   - kernel module changes
#   - filesystem mount changes
#   - system/network identity changes
#
# -e 2 makes the loaded audit configuration immutable until reboot.

-D
-b 8192
-f 1

# Persistent system files.
-a always,exit -F arch=b64 -F dir=/usr/ -F perm=wa -F key=system_files
-a always,exit -F arch=b32 -F dir=/usr/ -F perm=wa -F key=system_files

# Persistent system configuration.
-a always,exit -F arch=b64 -F dir=/etc/ -F perm=wa -F key=system_config
-a always,exit -F arch=b32 -F dir=/etc/ -F perm=wa -F key=system_config

# Pacman installed-package metadata.
-a always,exit -F arch=b64 -F dir=/var/lib/pacman/local/ -F perm=wa -F key=pacman_db
-a always,exit -F arch=b32 -F dir=/var/lib/pacman/local/ -F perm=wa -F key=pacman_db

# EFI System Partition: systemd-boot, loader config, signed UKIs.
-a always,exit -F arch=b64 -F dir=/efi/ -F perm=wa -F key=boot_files
-a always,exit -F arch=b32 -F dir=/efi/ -F perm=wa -F key=boot_files

# Privileged commands run from normal user login sessions.
-a always,exit -F arch=b64 -S execve,execveat -F euid=0 -F auid>=1000 -F auid!=unset -F key=privileged_exec
-a always,exit -F arch=b32 -S execve,execveat -F euid=0 -F auid>=1000 -F auid!=unset -F key=privileged_exec

# Kernel module loading/unloading.
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F key=modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -F key=modules

# Filesystem mount operations.
-a always,exit -F arch=b64 -S mount,umount2,move_mount,mount_setattr -F key=mounts
-a always,exit -F arch=b32 -S mount,umount2,move_mount,mount_setattr -F key=mounts

# System clock changes.
-a always,exit -F arch=b64 -S adjtimex,settimeofday -F key=time_change
-a always,exit -F arch=b32 -S adjtimex,settimeofday -F key=time_change

# Runtime hostname/domain changes.
-a always,exit -F arch=b64 -S sethostname,setdomainname -F key=network_identity
-a always,exit -F arch=b32 -S sethostname,setdomainname -F key=network_identity

# Make audit policy immutable until reboot.
-e 2
