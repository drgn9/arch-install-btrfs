#!/usr/bin/env bash

set -Eeuo pipefail

CONFIG=root
PACMAN_LOCK=/var/lib/pacman/db.lck
NORMAL_UKI=/efi/EFI/Linux/arch-linux.efi
pacman_lock_id=
pacman_lock_token=

die() {
    printf 'ERROR: %s\n' "$1" >&2
    exit 1
}

pacman_running() {
    local process

    for process in pacman pacstrap yay paru pamac-daemon packagekitd; do
        pgrep -x "$process" >/dev/null 2>&1 && return 0
    done
    return 1
}

acquire_pacman_lock() {
    pacman_running && die 'A package manager is currently running.'

    pacman_lock_token="rollback-root:$BASHPID:$RANDOM:$RANDOM"
    if ! (set -o noclobber; printf '%s\n' "$pacman_lock_token" >"$PACMAN_LOCK") 2>/dev/null; then
        die "$PACMAN_LOCK exists or could not be created."
    fi

    pacman_lock_id=$(stat -c '%d:%i' -- "$PACMAN_LOCK") || die "Could not identify the lock created at $PACMAN_LOCK."
    pacman_running && die 'A package manager started while acquiring the pacman lock.'
}

release_pacman_lock() {
    local current_id current_token

    [[ -n "$pacman_lock_token" ]] || return 0
    if [[ ! -e "$PACMAN_LOCK" ]]; then
        [[ -z "$pacman_lock_id" ]] && return 0
        return 1
    fi
    IFS= read -r current_token <"$PACMAN_LOCK" || return 1
    if [[ -z "$pacman_lock_id" ]]; then
        [[ "$current_token" == "$pacman_lock_token" ]] || return 1
    else
        current_id=$(stat -c '%d:%i' -- "$PACMAN_LOCK" 2>/dev/null) || return 1
        [[ "$current_id" == "$pacman_lock_id" && "$current_token" == "$pacman_lock_token" ]] || return 1
    fi

    rm -f -- "$PACMAN_LOCK" || return 1
    pacman_lock_id=
    pacman_lock_token=
}

confirm() {
    local prompt=$1
    local answer

    read -rp "$prompt [y/N] " answer
    [[ "$answer" == y || "$answer" == Y || "$answer" == yes || "$answer" == YES ]]
}

ensure_ready() {
    local efi_source key root_source sbctl_source snapshots_source

    [[ ${EUID:-0} -eq 0 ]] || die 'rollback-root must be run as root.'
    [[ "$(findmnt -no FSTYPE /)" == btrfs ]] || die '/ is not mounted as Btrfs.'
    [[ "$(findmnt -rn -M /.snapshots -o FSTYPE 2>/dev/null)" == btrfs ]] || die '/.snapshots is not mounted as Btrfs.'
    [[ "$(findmnt -rn -M /.snapshots -o FSROOT 2>/dev/null)" == /@snapshots ]] || die '/.snapshots is not mounted from @snapshots.'
    [[ "$(findmnt -rn -M /efi -o FSTYPE 2>/dev/null)" == vfat ]] || die '/efi is not mounted as vfat.'
    [[ -s "$NORMAL_UKI" ]] || die "$NORMAL_UKI is missing or empty."
    [[ "$(findmnt -rn -M /var/lib/sbctl -o FSTYPE 2>/dev/null)" == btrfs ]] || die '/var/lib/sbctl is not mounted as Btrfs.'
    [[ "$(findmnt -rn -M /var/lib/sbctl -o FSROOT 2>/dev/null)" == /@sbctl ]] || die '/var/lib/sbctl is not mounted from @sbctl.'
    root_source=$(readlink -f -- "$(findmnt -v -rn -M / -o SOURCE)")
    snapshots_source=$(readlink -f -- "$(findmnt -v -rn -M /.snapshots -o SOURCE)")
    sbctl_source=$(readlink -f -- "$(findmnt -v -rn -M /var/lib/sbctl -o SOURCE)")
    [[ "$snapshots_source" == "$root_source" && "$sbctl_source" == "$root_source" ]] || die 'Rollback subvolumes are not mounted from the root Btrfs filesystem.'
    efi_source=$(findmnt -rn -M /efi -o SOURCE)
    [[ "$(blkid -s PART_ENTRY_TYPE -o value "$efi_source" | tr '[:upper:]' '[:lower:]')" == c12a7328-f81f-11d2-ba4b-00a0c93ec93b ]] || die '/efi is not mounted from an EFI System Partition.'
    command -v sbctl >/dev/null 2>&1 || die 'sbctl is required for rollback.'
    command -v jq >/dev/null 2>&1 || die 'jq is required for Secure Boot verification.'
    for key in PK/PK.key PK/PK.pem KEK/KEK.key KEK/KEK.pem db/db.key db/db.pem; do
        [[ -r "/var/lib/sbctl/keys/$key" && -s "/var/lib/sbctl/keys/$key" ]] || die "Required sbctl key is unusable: /var/lib/sbctl/keys/$key"
    done
    verify_efi_signature "$NORMAL_UKI" || die 'The normal UKI is not signed by the installed Secure Boot key.'
    pacman_running && die 'A package manager is currently running.'
    [[ ! -e "$PACMAN_LOCK" ]] || die "$PACMAN_LOCK exists. Remove it only after verifying pacman is not running."
}

list_pairs() {
    snapper -c "$CONFIG" --csvout --separator '|' --no-headers list \
        --type pre-post --disable-used-space \
        --columns number,type,pre-number,date,description |
        awk -F'|' '$2 == "post" && $3 ~ /^[0-9]+$/ && $1 ~ /^[0-9]+$/ { printf "%s|%s|%s|%s\n", $3, $1, $4, $5 }'
}

select_pair() {
    local pairs=()
    local line index choice

    mapfile -t pairs < <(list_pairs | sort -t'|' -k2,2nr)
    (( ${#pairs[@]} > 0 )) || die 'No Snapper pre/post pairs found.'

    printf '\nRecent pacman transactions:\n\n'
    index=1
    for line in "${pairs[@]:0:20}"; do
        IFS='|' read -r pre post date description <<<"$line"
        printf '%2d. %s..%s  %s  %s\n' "$index" "$pre" "$post" "$date" "$description"
        ((index++))
    done

    read -rp $'\nSelect transaction: ' choice
    [[ "$choice" =~ ^[0-9]+$ ]] || die 'Selection must be a number.'
    (( choice >= 1 && choice < index )) || die 'Selection out of range.'

    IFS='|' read -r selected_pre selected_post _ <<<"${pairs[$((choice - 1))]}"
}

show_change_summary() {
    local status_file=$1
    local created deleted modified

    created=$(awk '$1 ~ /^\+/ { count++ } END { print count + 0 }' "$status_file")
    deleted=$(awk '$1 ~ /^-/ { count++ } END { print count + 0 }' "$status_file")
    modified=$(awk '$1 !~ /^[+-]/ { count++ } END { print count + 0 }' "$status_file")

    printf '\nChanges:\n'
    printf '  modify: %s\n' "$modified"
    printf '  create: %s\n' "$created"
    printf '  delete: %s\n' "$deleted"
}

verify_efi_signature() {
    local file=$1 verification

    verification=$(sbctl --json verify "$file")
    jq -e 'length == 1 and .[0].is_signed == 1' <<<"$verification" >/dev/null
}

sign_and_verify_ukis() {
    sbctl sign -s "$NORMAL_UKI"
    verify_efi_signature "$NORMAL_UKI"
    if [[ -f /efi/EFI/Linux/arch-rescue.efi ]]; then
        sbctl sign -s /efi/EFI/Linux/arch-rescue.efi
        verify_efi_signature /efi/EFI/Linux/arch-rescue.efi
    fi
    if [[ -f /usr/lib/fwupd/efi/fwupdx64.efi ]]; then
        sbctl sign -s -o /usr/lib/fwupd/efi/fwupdx64.efi.signed /usr/lib/fwupd/efi/fwupdx64.efi
        verify_efi_signature /usr/lib/fwupd/efi/fwupdx64.efi.signed
    fi
}

ensure_ready

if (( $# == 0 )); then
    select_pair
elif (( $# == 2 )); then
    [[ "$1" =~ ^[0-9]+$ && "$2" =~ ^[0-9]+$ ]] || die 'Snapshot numbers must be numeric.'
    selected_pre=$1
    selected_post=$2
else
    die 'Usage: rollback-root [PRE POST]'
fi

status_file=$(mktemp)
trap 'release_pacman_lock || printf "WARNING: rollback-root did not remove a changed or inaccessible pacman lock.\n" >&2; rm -f -- "$status_file"' EXIT

snapper -c "$CONFIG" status "$selected_pre..$selected_post" >"$status_file"
show_change_summary "$status_file"

printf '\n'
cat "$status_file"
printf '\n'

confirm "Undo transaction $selected_pre..$selected_post?" || die 'Rollback cancelled.'

acquire_pacman_lock
snapper -c "$CONFIG" undochange "$selected_pre..$selected_post"

mkinitcpio -P
sign_and_verify_ukis
release_pacman_lock || die 'The pacman lock changed during rollback and was not removed.'

cat <<'EOF'

Rollback finished.

This is a file-level reversal of one pacman transaction, not a complete
system downgrade. If you reversed a partial upgrade or a kernel/userspace
boundary, reboot now and inspect the system.
EOF

if confirm 'Reboot now?'; then
    systemctl reboot
fi
