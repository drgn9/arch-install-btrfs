#!/usr/bin/env bash

set -Eeuo pipefail

CONFIG=root
PACMAN_LOCK=/var/lib/pacman/db.lck

die() {
    printf 'ERROR: %s\n' "$1" >&2
    exit 1
}

pacman_running() {
    pgrep -x pacman >/dev/null 2>&1 || pgrep -x pacstrap >/dev/null 2>&1 || pgrep -x yay >/dev/null 2>&1
}

confirm() {
    local prompt=$1
    local answer

    read -rp "$prompt [y/N] " answer
    [[ "$answer" == y || "$answer" == Y || "$answer" == yes || "$answer" == YES ]]
}

ensure_ready() {
    [[ ${EUID:-0} -eq 0 ]] || die 'rollback-root must be run as root.'
    [[ "$(findmnt -no FSTYPE /)" == btrfs ]] || die '/ is not mounted as Btrfs.'
    findmnt -rn /.snapshots >/dev/null 2>&1 || die '/.snapshots is not mounted.'
    pacman_running && die 'pacman, pacstrap, or yay is currently running.'
    [[ ! -e "$PACMAN_LOCK" ]] || die "$PACMAN_LOCK exists. Remove it only after verifying pacman is not running."
}

select_latest_pair() {
    local pre post date description

    selected_pre=
    selected_post=0
    selected_date=
    selected_description=

    while IFS='|' read -r pre post date description; do
        [[ "$pre" =~ ^[0-9]+$ && "$post" =~ ^[0-9]+$ ]] || continue
        if (( post > selected_post )); then
            selected_pre=$pre
            selected_post=$post
            selected_date=$date
            selected_description=$description
        fi
    done < <(snapper -c "$CONFIG" --csvout --separator '|' --no-headers list \
        --type pre-post --disable-used-space \
        --columns number,post-number,date,description)

    [[ -n "$selected_pre" ]] || die 'No completed Snapper pre/post pairs found.'

    printf '\nLatest pacman transaction:\n\n'
    printf '  %s..%s  %s  %s\n' "$selected_pre" "$selected_post" "$selected_date" "$selected_description"
}

show_change_summary() {
    local status_file=$1
    local created deleted modified

    created=$(awk '$1 ~ /^\+/ { count++ } END { print count + 0 }' "$status_file")
    deleted=$(awk '$1 ~ /^-/ { count++ } END { print count + 0 }' "$status_file")
    modified=$(awk '$1 !~ /^[+-]/ { count++ } END { print count + 0 }' "$status_file")

    printf '\nChanges:\n'
    printf '  modify: %s\n' "$modified"
    printf '  create: %s\n' "$created"
    printf '  delete: %s\n' "$deleted"
}

# sbctl verify exits 0 even for unsigned files, so check the JSON output.
verify_signed_file() {
    local file=$1 verification

    verification=$(sbctl --json verify "$file") || die "Could not verify $file."
    jq -e 'length == 1 and .[0].is_signed == 1' <<<"$verification" >/dev/null \
        || die "$file is not signed. Fix signing before rebooting; the snapshot pair was retained."
}

sign_and_verify_ukis() {
    command -v sbctl >/dev/null 2>&1 || die 'sbctl is required to sign rebuilt UKIs.'
    command -v jq >/dev/null 2>&1 || die 'jq is required to verify rebuilt UKIs.'
    [[ -d /var/lib/sbctl/keys ]] || die 'Secure Boot keys are unavailable; refusing to leave rebuilt UKIs unsigned.'

    sbctl sign -s /efi/EFI/Linux/arch-linux.efi
    verify_signed_file /efi/EFI/Linux/arch-linux.efi
    if [[ -f /efi/EFI/Linux/arch-rescue.efi ]]; then
        sbctl sign -s /efi/EFI/Linux/arch-rescue.efi
        verify_signed_file /efi/EFI/Linux/arch-rescue.efi
    fi
    if [[ -f /usr/lib/fwupd/efi/fwupdx64.efi ]]; then
        sbctl sign -s -o /usr/lib/fwupd/efi/fwupdx64.efi.signed /usr/lib/fwupd/efi/fwupdx64.efi
        verify_signed_file /usr/lib/fwupd/efi/fwupdx64.efi.signed
    fi
}

ensure_ready

(( $# == 0 )) || die 'Usage: rollback-root'
select_latest_pair

status_file=$(mktemp)
trap 'rm -f "$status_file"' EXIT

snapper -c "$CONFIG" status "$selected_pre..$selected_post" >"$status_file"
show_change_summary "$status_file"

printf '\n'
cat "$status_file"
printf '\n'

confirm "Undo transaction $selected_pre..$selected_post and delete its snapshots after success?" || die 'Rollback cancelled.'

snapper -c "$CONFIG" undochange "$selected_pre..$selected_post"

if [[ -e "$PACMAN_LOCK" ]] && ! pacman_running; then
    rm -f "$PACMAN_LOCK"
fi

mkinitcpio -P
sign_and_verify_ukis

if ! snapper -c "$CONFIG" delete "$selected_pre" "$selected_post"; then
    die "Rollback succeeded, but snapshots $selected_pre and $selected_post could not be deleted. Delete them manually with: snapper -c $CONFIG delete $selected_pre $selected_post"
fi

cat <<'EOF'

Rollback finished.

This is a file-level reversal of one pacman transaction, not a complete
system downgrade.

REBOOT REQUIRED: reboot before continuing to use the system so the running
kernel and userspace match the rolled-back files and rebuilt UKI.
EOF

if confirm 'Reboot now?'; then
    systemctl reboot
else
    printf 'Reboot is still required. Run: systemctl reboot\n'
fi
