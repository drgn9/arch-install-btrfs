
output "eDP-1" {
  backdrop-color "#1a1b26"
  scale 2.0
  position x=0 y=0
}

output "HDMI-A-1" {
  focus-at-startup
  backdrop-color "#1a1b26"
}

cursor {
  xcursor-theme "Adwaita"
  xcursor-size 24
}

layout {
  background-color "#1a1b26"
  gaps 18
  default-column-width { proportion 0.5; }
}

hotkey-overlay {
  skip-at-startup
}

gestures {
  hot-corners {
    off
  }
}

prefer-no-csd

binds {
  Mod+Shift+Slash { show-hotkey-overlay; }
  Mod+O repeat=false { toggle-overview; }
  Mod+Shift+Return hotkey-overlay-title="foot" { spawn "foot"; }
  Mod+Shift+I hotkey-overlay-title="impala" { spawn "foot" "-a" "float-app" "impala"; }
  Mod+P hotkey-overlay-title="fuzzel" { spawn "fuzzel"; }
  Mod+Shift+C repeat=false { close-window; }

  Mod+H     { focus-column-left; }
  Mod+J     { focus-window-or-workspace-down; }
  Mod+K     { focus-window-or-workspace-up; }
  Mod+L     { focus-column-right; }

  Mod+Shift+H     { move-column-left; }
  Mod+Shift+J     { move-window-down-or-to-workspace-down; }
  Mod+Shift+K     { move-window-up-or-to-workspace-up; }
  Mod+Shift+L     { move-column-right; }

  Mod+Ctrl+H  { consume-or-expel-window-left; }
  Mod+Ctrl+L { consume-or-expel-window-right; }

  Mod+BracketLeft  { consume-window-into-column; }
  Mod+BracketRight { expel-window-from-column; }

  Mod+Comma  { focus-monitor-left; }
  Mod+Period { focus-monitor-right; }
  Mod+Shift+Comma  { move-column-to-monitor-left; }
  Mod+Shift+Period { move-column-to-monitor-right; }

  Mod+Down { focus-workspace-down; }
  Mod+Up { focus-workspace-up; }
  Mod+Shift+Down { move-column-to-workspace-down; }
  Mod+Shift+Up { move-column-to-workspace-up; }

  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
  Mod+3 { focus-workspace 3; }
  Mod+4 { focus-workspace 4; }
  Mod+5 { focus-workspace 5; }
  Mod+6 { focus-workspace 6; }
  Mod+7 { focus-workspace 7; }
  Mod+8 { focus-workspace 8; }
  Mod+9 { focus-workspace 9; }
  Mod+Shift+1 { move-window-to-workspace 1; }
  Mod+Shift+2 { move-window-to-workspace 2; }
  Mod+Shift+3 { move-window-to-workspace 3; }
  Mod+Shift+4 { move-window-to-workspace 4; }
  Mod+Shift+5 { move-window-to-workspace 5; }
  Mod+Shift+6 { move-window-to-workspace 6; }
  Mod+Shift+7 { move-window-to-workspace 7; }
  Mod+Shift+8 { move-window-to-workspace 8; }
  Mod+Shift+9 { move-window-to-workspace 9; }

  Mod+Shift+T { toggle-column-tabbed-display; }
  Mod+M { maximize-column; }
  Mod+F       { toggle-window-floating; }
  Mod+Shift+F { switch-focus-between-floating-and-tiling; }
}
