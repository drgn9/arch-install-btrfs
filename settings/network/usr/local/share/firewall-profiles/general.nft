#!/usr/bin/nft -f

# General extends the default policy with physical-LAN discovery traffic.
destroy table inet my_table
destroy table inet workstation

table inet workstation {
    chain input {
        type filter hook input priority filter; policy drop;

        iifname "lo" counter accept comment "allow loopback"
        ct state invalid counter drop comment "drop invalid traffic"
        ct state { established, related } counter accept comment "allow tracked replies"

        meta nfproto ipv4 udp sport 67 udp dport 68 counter accept comment "allow DHCPv4 replies"
        meta nfproto ipv6 udp sport 547 udp dport 546 counter accept comment "allow DHCPv6 replies"

        icmp type {
            destination-unreachable,
            time-exceeded,
            parameter-problem
        } counter accept comment "allow essential ICMP"

        icmpv6 type {
            destination-unreachable,
            packet-too-big,
            time-exceeded,
            parameter-problem,
            mld-listener-query,
            nd-router-advert,
            nd-neighbor-solicit,
            nd-neighbor-advert
        } counter accept comment "allow essential ICMPv6"

        meta iiftype ether icmp type echo-request limit rate 5/second burst 10 packets \
            counter accept comment "allow rate-limited LAN ping"
        meta iiftype ether icmpv6 type echo-request limit rate 5/second burst 10 packets \
            counter accept comment "allow rate-limited LAN ping6"

        meta iiftype ether ip protocol igmp counter accept comment "allow LAN multicast membership"
        meta iiftype ether ip daddr 224.0.0.251 ip ttl 255 udp dport 5353 \
            counter accept comment "allow LAN mDNS IPv4"
        meta iiftype ether ip6 daddr ff02::fb ip6 hoplimit 255 udp dport 5353 \
            counter accept comment "allow LAN mDNS IPv6"

        counter comment "default input drop"
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        counter comment "default forward drop"
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
