#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

ESP=/efi
SBCTL_STATE=/var/lib/sbctl
LOCK_FILE=/run/lock/update-rescue.lock
TARGET="$ESP/EFI/Linux/arch-rescue.efi"
# @sbctl survives root rollback/reinstall. Keeping the backup here also avoids
# needing room for three large rescue images on the 2 GiB ESP while staging.
BACKUP_DIR="$SBCTL_STATE/rescue-backups"
BACKUP="$BACKUP_DIR/arch-rescue.efi"
STAGED=
BACKUP_STAGED=
PROMOTED=no

die() {
    printf 'ERROR: %s\n' "$1" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: update-rescue /path/to/arch-install-btrfs
       update-rescue --restore

Run from the installed system as root. The first form builds a fresh rescue
UKI, signs and verifies it, backs up the current image, and installs it.
The builder prompts for the password to use in the new rescue environment.

--restore restores the previous image without rebuilding or accessing the
network. It leaves the backup available and does not back up the rejected image.
EOF
}

cleanup() {
    local status=$?
    [[ -z "$STAGED" ]] || rm -f -- "$STAGED" || true
    [[ -z "$BACKUP_STAGED" ]] || rm -f -- "$BACKUP_STAGED" || true
    if (( status != 0 )) && [[ "$PROMOTED" == yes ]]; then
        printf 'The rescue image was replaced, but a later step failed.\n' >&2
        printf 'Previous image: %s\nRestore with: sudo update-rescue --restore\n' "$BACKUP" >&2
    fi
}

ensure_mounts() {
    [[ "$(findmnt -nro FSTYPE /)" == btrfs ]] \
        || die 'Run update-rescue from the installed Btrfs system, not the live/rescue environment.'
    [[ "$(findmnt -nro FSTYPE --mountpoint "$ESP")" == vfat ]] \
        || die "$ESP must be mounted as the EFI System Partition (vfat)."
    [[ "$(findmnt -nro FSTYPE --mountpoint "$SBCTL_STATE")" == btrfs ]] \
        || die "$SBCTL_STATE must be mounted from the persistent @sbctl subvolume."
    [[ -d "$SBCTL_STATE/keys" ]] || die 'The existing Secure Boot signing keys are unavailable.'
}

verify_signed_file() {
    local file=$1 verification

    verification=$(sbctl --json verify "$file") || die "Could not verify $file."
    # sbctl verify can exit 0 for unsigned/invalid files. Require a positive
    # result for this exact file, verified against the existing local db key.
    jq -e --arg file "$file" \
        'length == 1 and .[0].file_name == $file and .[0].is_signed == 1' \
        <<<"$verification" >/dev/null || die "$file is not signed with this machine's db key."
}

inspect_rescue_image() {
    local file=$1 inspection

    [[ "$(bootctl kernel-identify "$file")" == uki ]] || die "$file is not a UKI."
    inspection=$(/usr/lib/systemd/ukify --json=short inspect "$file") \
        || die "Could not inspect $file. Install systemd-ukify and python-pefile."
    jq -e '
        .[".initrd"].size > 0 and
        (.[".osrel"].text | split("\n") |
            any(. == "IMAGE_ID=arch-rescue" or . == "IMAGE_ID=\"arch-rescue\""))
    ' <<<"$inspection" >/dev/null || die "$file is not an arch-rescue image with an embedded filesystem."
    jq -r '
        "  Kernel: " + (.[".uname"].text // "unknown"),
        "  " + (.[".osrel"].text | split("\n") |
            map(select(startswith("IMAGE_VERSION="))) | first // "IMAGE_VERSION=unknown")
    ' <<<"$inspection"
}

stage_image() {
    local source=$1 needed available

    ensure_mounts
    needed=$(( $(stat -c %s -- "$source") + 1048576 ))
    available=$(df -P -B1 "$ESP" | awk 'NR == 2 { print $4 }')
    [[ "$available" =~ ^[0-9]+$ ]] || die "Could not determine free space on $ESP."
    (( available >= needed )) \
        || die "Not enough free space on $ESP to stage the replacement alongside the current image."

    STAGED=$(mktemp "$ESP/EFI/Linux/.arch-rescue-update.XXXXXX")
    install -m 0644 -- "$source" "$STAGED"
    cmp -s -- "$source" "$STAGED" || die 'The staged image does not match its source.'
}

backup_current_image() {
    mkdir -p -- "$BACKUP_DIR"
    BACKUP_STAGED=$(mktemp "$BACKUP_DIR/.arch-rescue-backup.XXXXXX")
    cp --reflink=auto -- "$TARGET" "$BACKUP_STAGED"
    cmp -s -- "$TARGET" "$BACKUP_STAGED" || die 'The backup does not match the current rescue image.'
    sync -f "$BACKUP_STAGED"
    mv -fT -- "$BACKUP_STAGED" "$BACKUP"
    BACKUP_STAGED=
    sync -f "$BACKUP_DIR"
    printf 'Previous rescue image saved to: %s\n' "$BACKUP"
}

promote_staged_image() {
    sync -f "$STAGED"
    # The staged file is already signed and verified, and is on the same
    # filesystem as the target. No partially copied image is exposed here.
    mv -fT -- "$STAGED" "$TARGET"
    PROMOTED=yes
    STAGED=
    sync -f "$ESP"
    verify_signed_file "$TARGET"
}

main() {
    local mode=update result=updated repo source dep

    case "${1:-}" in
        -h|--help) usage; return 0 ;;
        --restore) mode=restore ;;
        ''|-*) usage >&2; return 2 ;;
    esac
    (( $# == 1 )) || { usage >&2; return 2; }
    [[ ${EUID:-0} -eq 0 ]] || die 'update-rescue must be run as root.'
    for dep in sbctl jq bootctl flock; do
        command -v "$dep" >/dev/null 2>&1 || die "Required command not installed: $dep"
    done
    exec {lock_fd}>"$LOCK_FILE"
    flock -n "$lock_fd" || die 'Another update-rescue process is already running.'
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    ensure_mounts
    # sbctl must inspect/sign files on the same ESP we are maintaining.
    export SYSTEMD_ESP_PATH="$ESP"

    if [[ "$mode" == restore ]]; then
        result=restored
        [[ -s "$BACKUP" ]] || die "No previous rescue image found at $BACKUP."
        printf 'Restoring the previous rescue image...\n'
        stage_image "$BACKUP"
        inspect_rescue_image "$STAGED"
        verify_signed_file "$STAGED"
    else
        repo=$(realpath -e -- "$1")
        [[ -f "$repo/rescue-uki/build.sh" && -f "$repo/build-common.bash" ]] \
            || die 'Pass the path to a complete arch-install-btrfs repository checkout.'
        [[ -s "$TARGET" ]] || die "No installed rescue image found at $TARGET."
        printf 'Building a new rescue image from: %s\n' "$repo"
        bash "$repo/rescue-uki/build.sh"
        source="$repo/artifacts/arch-rescue.efi"
        [[ -s "$source" ]] || die "The builder did not produce $source."

        printf '\nStaging the new rescue image...\n'
        stage_image "$source"
        inspect_rescue_image "$STAGED"
        # Do not register the temporary filename in sbctl's signing database.
        # The installed path is already registered by the original installer.
        sbctl sign "$STAGED"
        verify_signed_file "$STAGED"
        backup_current_image
    fi

    promote_staged_image
    printf '\nRescue image %s and verified: %s\n' "$result" "$TARGET"
    printf 'Backup retained at: %s\n' "$BACKUP"
    printf 'Boot-test it when ready: sudo systemctl reboot --boot-loader-entry=arch-rescue.efi\n'
    printf 'From rescue, test unlocking/mounting with the repair action, then reboot to the desktop.\n'
    printf 'If needed, restore from the desktop with: sudo update-rescue --restore\n'
}

main "$@"
