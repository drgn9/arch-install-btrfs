#!/usr/bin/env bash

# Guided rescue entry point for systems installed by Arch New Installer.
# It can either mount the installed system for manual repair or replace the
# root subvolume (@) from an existing Snapper snapshot.

set -Eeuo pipefail

BTRFS_MOUNT_OPTIONS="noatime,compress=zstd:3"
BTRFS_STRICT_MOUNT_OPTIONS="$BTRFS_MOUNT_OPTIONS,nodev,nosuid,noexec"
EFI_MOUNT_OPTIONS="fmask=0137,dmask=0027,nodev,nosuid,noexec"

opened_luks=no
mounted=no
top_mounted=no
cleanup_enabled=yes
retired_root=
REINSTALL_MIN_FREE_GIB=16

# The styling helpers and the reinstall payload are installed beside each
# other: at /usr/local/share/arch-new-install in the rescue UKI and at
# /root/arch-new-install on the live ISO.
payload_dir=
for candidate in /usr/local/share/arch-new-install /root/arch-new-install; do
    if [[ -f "$candidate/ui.bash" ]]; then
        payload_dir=$candidate
        break
    fi
done
if [[ -z "$payload_dir" ]]; then
    echo "ERROR: rescue-root support files not found. Rebuild the rescue image with ./iso/build.sh." >&2
    exit 1
fi
# shellcheck source=ui.bash
# shellcheck disable=SC1091
source "$payload_dir/ui.bash"

die() {
    show_error "$1"
    exit 1
}

confirm() {
    gum confirm "$1"
}

cleanup_on_failure() {
    local status=${1:-$?}

    (( status != 0 )) || return 0
    [[ "$cleanup_enabled" == yes ]] || return 0

    if [[ "$mounted" == yes || "$top_mounted" == yes ]]; then
        umount -R /mnt 2>/dev/null || true
    fi
    if [[ "$opened_luks" == yes ]]; then
        cryptsetup close cryptroot 2>/dev/null || true
    fi
    if [[ -n "$retired_root" ]]; then
        show_warn "The previous root is retained as $retired_root. Re-running the reinstall action is safe."
        show_warn "To go back to the previous root instead: from the Btrfs top level, delete the new @ and rename $retired_root to @, then choose Repair and run mkinitcpio -P in the chroot."
    fi
}
trap 'cleanup_on_failure "$?"' EXIT
trap 'exit 130' INT TERM

partition_path() {
    local disk=$1
    local number=$2

    if [[ "$disk" =~ [0-9]$ ]]; then
        printf '%sp%s\n' "$disk" "$number"
    else
        printf '%s%s\n' "$disk" "$number"
    fi
}

select_target() {
    local devices unlock

    if findmnt -rn /mnt >/dev/null 2>&1; then
        die '/mnt is already mounted. Unmount it first: umount -R /mnt'
    fi

    if [[ -e /dev/mapper/cryptroot ]]; then
        die '/dev/mapper/cryptroot already exists. Close it first: cryptsetup close cryptroot'
    fi

    show_section "System Disk"
    devices=$(lsblk --nodeps --paths --list --noheadings --sort=size --output=name,size,type,model | awk '$3 == "disk"')
    [[ -n "$devices" ]] || die 'No disks found.'

    target_disk=$(printf '%s\n' "$devices" | gum choose --header 'Select the disk your system is installed on:' | awk '{print $1}')
    efi_part=$(partition_path "$target_disk" 1)
    root_part=$(partition_path "$target_disk" 2)

    [[ -b "$efi_part" && -b "$root_part" ]] || die "Expected partitions $efi_part and $root_part not found on $target_disk."

    root_device="$root_part"
    if cryptsetup isLuks "$root_part"; then
        show_section "Unlock Root"
        unlock=$(gum choose --header "How do you want to unlock $root_part?" \
            'FIDO2 or TPM2 token (with PIN)' \
            'Passphrase or recovery key')
        if [[ "$unlock" == 'FIDO2 or TPM2 token (with PIN)' ]]; then
            show_action "Action required: security token" \
                "Insert your FIDO2 key if you use one." \
                "The next prompt asks for your token PIN."
            cryptsetup open --token-only "$root_part" cryptroot
        else
            show_action "Action required: LUKS unlock" \
                "Enter a LUKS passphrase or recovery key at the next prompt."
            cryptsetup open --disable-external-tokens "$root_part" cryptroot
        fi
        opened_luks=yes
        root_device=/dev/mapper/cryptroot
    fi
}

mount_installed_system() {
    mount -o "$BTRFS_MOUNT_OPTIONS,subvol=@" "$root_device" /mnt
    mounted=yes

    if [[ -d /mnt/efi ]]; then
        mount -o "$EFI_MOUNT_OPTIONS" "$efi_part" /mnt/efi
    else
        show_warn '/mnt/efi does not exist; the ESP was not mounted.'
    fi

    # @sbctl holds the Secure Boot keys; without it no UKI can be signed.
    install -d -m 0755 /mnt/var/lib/sbctl
    if ! mount -o "$BTRFS_STRICT_MOUNT_OPTIONS,subvol=@sbctl" "$root_device" /mnt/var/lib/sbctl; then
        show_warn 'Could not mount @sbctl; UKI signing will be unavailable.'
    fi
}

mount_for_repair() {
    local -a next_steps

    select_target
    show_section "Repair Environment"
    mount_installed_system

    cleanup_enabled=no
    trap - INT TERM

    show_success "Installed system mounted at /mnt."
    next_steps=(
        "Enter the system:  arch-chroot /mnt"
        "Mount the rest:    mount -a"
        "Leave the chroot:  exit"
        "Unmount system:    umount -R /mnt"
    )
    if [[ "$opened_luks" == yes ]]; then
        next_steps+=("Close encryption:  cryptsetup close cryptroot")
    fi
    show_note "Next steps" "${next_steps[@]}"
}

list_snapshots() {
    local snapshot_dir entry info description

    snapshot_dir=/mnt/@snapshots
    [[ -d "$snapshot_dir" ]] || die '@snapshots was not found.'

    for entry in "$snapshot_dir"/*; do
        [[ -d "$entry/snapshot" ]] || continue
        description=''
        info="$entry/info.xml"
        if [[ -f "$info" ]]; then
            description=$(grep -m1 '<description>' "$info" | sed -E 's/.*<description>(.*)<\/description>.*/\1/' || true)
        fi
        printf '%s %s\n' "${entry##*/}" "$description"
    done | sort -n
}

# Deletes a subvolume and any child subvolumes beneath it (snapper snapshots
# under @snapshots, container-created subvolumes under @docker/@containers).
# A child always sorts after its parent lexicographically, so reverse order
# deletes children first. Paths are relative to the top-level mount at /mnt.
delete_subvolume_tree() {
    local subvolume=$1
    local child

    while IFS= read -r child; do
        btrfs subvolume delete "/mnt/$child"
    done < <(btrfs subvolume list /mnt | sed -n 's/.* path //p' | \
        awk -v prefix="$subvolume/" 'index($0, prefix) == 1' | sort -r)
    btrfs subvolume delete "/mnt/$subvolume"
}

# Rebuilds and signs the normal UKI from a root that is not booted. The ESP
# and @sbctl are mounted inside it so mkinitcpio writes the real UKI and
# sbctl finds the Secure Boot keys. mkinitcpio's sbctl hook already signs the
# UKI; the explicit sign turns a missing key or tool into a hard failure.
rebuild_uki_from() {
    local root=$1

    mount -o "$EFI_MOUNT_OPTIONS" "$efi_part" "$root/efi" &&
        mount -o "$BTRFS_STRICT_MOUNT_OPTIONS,subvol=@sbctl" "$root_device" "$root/var/lib/sbctl" &&
        arch-chroot "$root" mkinitcpio -P &&
        arch-chroot "$root" sbctl sign -s /efi/EFI/Linux/arch-linux.efi &&
        umount "$root/var/lib/sbctl" "$root/efi"
}

replace_root_from_snapshot() {
    local snapshots selection snapshot old_root candidate timestamp

    select_target

    mount -o "$BTRFS_MOUNT_OPTIONS,subvolid=5" "$root_device" /mnt
    top_mounted=yes

    show_section "Choose Snapshot"
    snapshots=$(list_snapshots)
    [[ -n "$snapshots" ]] || die 'No Snapper snapshots found.'

    selection=$(printf '%s\n' "$snapshots" | gum choose --header 'Select the snapshot to restore as @:')
    snapshot=${selection%% *}
    [[ -d "/mnt/@snapshots/$snapshot/snapshot" ]] || die "Snapshot $snapshot is invalid."

    show_action "Confirm root replacement" \
        "Restore snapshot: $selection" \
        "The current root will be kept as an @old-* subvolume."
    confirm 'Replace the current root?' || die 'Root replacement cancelled.'

    timestamp=$(date +%Y%m%d-%H%M%S)
    old_root="@old-$timestamp"
    candidate="/mnt/@new-$timestamp"
    [[ -d /mnt/@ ]] || die 'Current root subvolume @ was not found.'

    show_section "Restoring Root"
    show_info "Creating replacement from snapshot $snapshot"
    btrfs subvolume snapshot "/mnt/@snapshots/$snapshot/snapshot" "$candidate"

    # snap-pac pre snapshots capture pacman's transaction lock. Nothing can
    # hold a lock inside a root that has never booted, so clear it now.
    rm -f "$candidate/var/lib/pacman/db.lck"

    trap '' INT TERM
    show_info 'Rebuilding and signing the UKI from the replacement root'
    if ! rebuild_uki_from "$candidate"; then
        umount "$candidate/var/lib/sbctl" "$candidate/efi" 2>/dev/null || true
        btrfs subvolume delete "$candidate" || true
        die "Could not rebuild the UKI from snapshot $snapshot; the current root was not changed. If the installed system no longer boots, run rescue-root again and choose another snapshot, or choose Repair and run mkinitcpio -P in the chroot."
    fi

    # The old root stays as the fallback: every mount names subvol=@, so the
    # two renames are the whole promotion. Reset the default subvolume to the
    # top level so no retired root is ever undeletable as the default.
    mv -T -- /mnt/@ "/mnt/$old_root"
    mv -T -- "$candidate" /mnt/@ ||
        die "Could not promote the replacement root. DO NOT REBOOT: the previous root is $old_root; rename it back to @ from the Btrfs top level first."
    btrfs subvolume set-default 5 /mnt
    trap 'exit 130' INT TERM

    umount -R /mnt
    top_mounted=no

    if [[ "$opened_luks" == yes ]]; then
        cryptsetup close cryptroot
        opened_luks=no
    fi

    show_success "Root restored from snapshot $snapshot."
    show_note "Old root retained" \
        "$old_root" \
        "Keep it until the restored system is verified." \
        "Delete it later with Btrfs Assistant or btrfs subvolume delete."

    if confirm 'Reboot now?'; then
        systemctl reboot
    fi
}

# --- Rescue reinstall -------------------------------------------------------

preflight_verify_layout() {
    local subvolume
    local -a missing=()

    while read -r subvolume; do
        [[ -d "/mnt/$subvolume" ]] || missing+=("$subvolume")
    done < <(printf '@\n'; layout_subvolumes keep ask)
    if (( ${#missing[@]} > 0 )); then
        die "Missing subvolumes: ${missing[*]}. This is not a system created by this installer; reinstall supports only installer-created layouts."
    fi

    if [[ ! -d /mnt/@sbctl/keys ]] || [[ -z "$(ls -A /mnt/@sbctl/keys 2>/dev/null)" ]]; then
        die '@sbctl contains no Secure Boot key material; new UKIs could not be signed. Reinstall requires the preserved sbctl keys.'
    fi
}

preflight_verify_esp() {
    local esp_probe

    esp_probe=$(mktemp -d /run/arch-rescue-esp-probe.XXXXXX)
    if ! mount -o "$EFI_MOUNT_OPTIONS" "$efi_part" "$esp_probe"; then
        rmdir "$esp_probe"
        die "Could not mount the ESP $efi_part."
    fi
    if ! umount "$esp_probe"; then
        die "Could not unmount the ESP probe at $esp_probe."
    fi
    rmdir "$esp_probe"
}

# The current root is retained, so the new system needs room beside it.
preflight_verify_free_space() {
    local free_gib

    free_gib=$(( $(df --output=avail -B1 /mnt | tail -n 1) / 1073741824 ))
    if (( free_gib < REINSTALL_MIN_FREE_GIB )); then
        die "Only $free_gib GiB is free on the Btrfs filesystem. Reinstall keeps the current root and needs at least $REINSTALL_MIN_FREE_GIB GiB. Free some space, for example by deleting old @old-* subvolumes, then run rescue-root again."
    fi
}

choose_home_disposition() {
    local home_choice confirmation

    show_section "Home Subvolume"
    erase_home=no
    home_choice=$(gum choose --header 'What should happen to @home (user data)?' \
        'Preserve @home (keep all user data)' \
        'Erase @home (destroy all user data)')
    if [[ "$home_choice" == Erase* ]]; then
        show_danger "Destructive: erase @home" \
            "All user data in /home will be destroyed." \
            "There is no retained copy and no undo."
        confirmation=$(gum input --header 'Type ERASE to confirm erasing @home:' --placeholder 'ERASE')
        [[ "$confirmation" == ERASE ]] || die '@home erase was not confirmed; nothing was changed.'
        erase_home=yes
    fi
}

verify_home_ownership() {
    local expected actual

    expected="$(target_chroot id -u "$username"):$(target_chroot id -g "$username")"
    actual=$(stat -c '%u:%g' "/mnt/home/$username" 2>/dev/null || echo missing)
    if [[ "$actual" != "$expected" ]]; then
        show_warn "/home/$username is owned by $actual, expected $expected. Fix after boot with: chown -R $expected /home/$username"
    fi
}

# The reinstalled system must unlock with what the LUKS2 header actually
# contains; a wrong crypttab.initramfs on a token-only system is unbootable,
# so the method is detected, never freely chosen.
detect_enrolled_unlock_method() {
    local luks_dump chosen
    local -a token_types

    show_section "Boot Unlock Method"
    luks_dump=$(cryptsetup luksDump "$root_part") || die "Could not read the LUKS header on $root_part."
    mapfile -t token_types < <(grep -oE 'systemd-(tpm2|fido2)' <<<"$luks_dump" | sort -u)

    case "${#token_types[@]}" in
        0)
            unlock_method=passphrase
            show_info 'No TPM2 or FIDO2 tokens are enrolled; boot unlock uses the passphrase.'
            ;;
        1)
            [[ "${token_types[0]}" == systemd-tpm2 ]] && unlock_method=tpm2 || unlock_method=fido2
            show_info "Detected enrolled LUKS unlock method: $unlock_method"
            ;;
        *)
            chosen=$(printf '%s\n' "${token_types[@]}" | gum choose --header 'Multiple token types are enrolled. Select the boot unlock method:')
            [[ "$chosen" == systemd-tpm2 ]] && unlock_method=tpm2 || unlock_method=fido2
            ;;
    esac
}

reinstall_preserving_state() {
    local payload_version subvolume

    show_section "Reinstall OS Preserving Selected State"
    payload_version=$(head -n 1 "$payload_dir/payload-version" 2>/dev/null || true)
    show_info "Embedded installer payload: ${payload_version:-unknown version}"
    show_warn 'The embedded packages and settings are frozen at image build time; rebuild the ISO to refresh them.'

    SCRIPT_DIR=$payload_dir
    SETTINGS_DIR=$payload_dir/settings
    # shellcheck source=installer-common.bash
    # shellcheck disable=SC1091
    source "$payload_dir/installer-common.bash"

    select_target

    mount -o "$BTRFS_MOUNT_OPTIONS,subvolid=5" "$root_device" /mnt
    top_mounted=yes

    show_section "Reinstall Preflight"
    preflight_verify_layout
    preflight_verify_esp
    preflight_verify_free_space

    show_info 'Checking network reachability'
    if ! have_network; then
        show_wifi_instructions rescue-root
        die 'No internet access. Returning to the shell; connect, then run rescue-root again.'
    fi

    # The rescue image keyring is frozen at build time; a stale keyring is
    # the most likely pacstrap failure, so refresh it before anything
    # destructive happens.
    show_info 'Refreshing archlinux-keyring in the rescue environment'
    pacman -Sy --needed --noconfirm archlinux-keyring

    collect_selected_packages
    preflight_validate_packages

    prompt_system_settings
    choose_home_disposition
    detect_enrolled_unlock_method

    local -a effective_preserve effective_recreate
    mapfile -t effective_preserve < <(layout_subvolumes keep)
    mapfile -t effective_recreate < <(layout_subvolumes recreate)
    if [[ "$erase_home" == yes ]]; then
        effective_recreate+=(@home)
    else
        effective_preserve+=(@home)
    fi

    show_danger "Confirm reinstall" \
        "Preserved:  ${effective_preserve[*]}" \
        "Recreated:  ${effective_recreate[*]}" \
        "Boot unlock: $unlock_method (from the LUKS header)" \
        "The current root is retained as @old-reinstall-<timestamp>." \
        "Partition table, ESP, LUKS container, and Secure Boot keys are kept."
    confirm 'Retire the current root and reinstall?' || die 'Reinstall cancelled; nothing was changed.'

    show_section "Retiring Current Root"
    local timestamp old_root
    timestamp=$(date +%Y%m%d-%H%M%S)
    old_root="@old-reinstall-$timestamp"
    [[ ! -e "/mnt/$old_root" ]] || die "Subvolume $old_root already exists."

    show_info "Renaming @ to $old_root"
    mv -T -- /mnt/@ "/mnt/$old_root"
    retired_root=$old_root

    for subvolume in "${effective_recreate[@]}"; do
        [[ "$subvolume" != @ ]] || continue
        if [[ -d "/mnt/$subvolume" ]]; then
            show_info "Deleting $subvolume"
            delete_subvolume_tree "$subvolume"
        fi
    done

    show_section "Recreating Subvolumes"
    for subvolume in "${effective_recreate[@]}"; do
        btrfs subvolume create "/mnt/$subvolume"
    done

    # Every mount names subvol=@; keep the default at the top level so no
    # retired root is ever undeletable as the default subvolume.
    btrfs subvolume set-default 5 /mnt

    umount /mnt
    top_mounted=no

    show_section "Mounting Target Layout"
    mount_target_layout
    mounted=yes

    install_target_system
    verify_home_ownership
    unset userpass userpass2

    # No sbctl create-keys or enroll-keys: the preserved @sbctl keys sign
    # everything, which is what makes reinstall work without Setup Mode.
    show_section "Secure Boot"
    install_and_sign_boot_manager
    finalize_target_dns

    show_section "Finalizing Reinstall"
    trap '' INT TERM
    if ! umount -R /mnt; then
        die "Failed to unmount /mnt cleanly. Close open files, then run: umount -R /mnt; cryptsetup close cryptroot. The previous root is retained as $old_root."
    fi
    mounted=no
    top_mounted=no
    if [[ "$opened_luks" == yes ]]; then
        if ! cryptsetup close cryptroot; then
            die "Failed to close cryptroot; close it manually before rebooting: cryptsetup close cryptroot. The previous root is retained as $old_root."
        fi
        opened_luks=no
    fi
    trap 'exit 130' INT TERM
    cleanup_enabled=no
    retired_root=

    show_success "Reinstall complete."
    show_note "Old root retained" \
        "$old_root" \
        "Keep it until the reinstalled system is verified." \
        "Delete it later with Btrfs Assistant or btrfs subvolume delete."

    if confirm 'Reboot now?'; then
        systemctl reboot
    fi
}

if [[ ${EUID:-0} -ne 0 ]]; then
    die 'This script must be run as root.'
fi

show_header "Arch Rescue" "repair · restore · reinstall"
show_section "Choose Rescue Action"
action=$(gum choose --header 'What do you need to do?' \
    'Repair installed system' \
    'Restore root from snapshot' \
    'Reinstall OS preserving selected state')

case "$action" in
    'Repair installed system') mount_for_repair ;;
    'Restore root from snapshot') replace_root_from_snapshot ;;
    'Reinstall OS preserving selected state') reinstall_preserving_state ;;
esac
