#!/usr/bin/env bash

# Guided rescue entry point for systems installed by Arch New Installer.
# It can either mount the installed system for manual repair or replace the
# root subvolume (@) from an existing Snapper snapshot.

set -Eeuo pipefail

BTRFS_MOUNT_OPTIONS="noatime,compress=zstd:3"
BTRFS_STRICT_MOUNT_OPTIONS="$BTRFS_MOUNT_OPTIONS,nodev,nosuid,noexec"
EFI_MOUNT_OPTIONS="fmask=0137,dmask=0027,nodev,nosuid,noexec"

opened_luks=no
mounted=no
top_mounted=no
cleanup_enabled=yes
temporary_esp_mount=
UI_ACCENT=212
UI_ACTION=214
UI_SUCCESS=82
UI_WIDTH=74

show_header() {
    clear
    gum style \
        --foreground "$UI_ACCENT" --border-foreground "$UI_ACCENT" --border double \
        --align center --width "$UI_WIDTH" --margin "1 2" --padding "1 2" \
        "Arch Rescue"
}

show_section() {
    gum style \
        --foreground "$UI_ACCENT" --border-foreground "$UI_ACCENT" --border rounded \
        --bold --width "$UI_WIDTH" --margin "1 2" --padding "0 2" \
        "$1"
}

show_action() {
    local title=$1
    shift

    gum style \
        --foreground "$UI_ACTION" --border-foreground "$UI_ACTION" --border double \
        --bold --width "$UI_WIDTH" --margin "1 2" --padding "1 2" \
        "$title" "" "$@"
}

show_info() {
    gum log --level info "$1"
}

show_warn() {
    gum log --level warn "$1"
}

show_success() {
    gum style --foreground "$UI_SUCCESS" --bold --margin "1 2" "$1"
}

die() {
    gum log --level error "$1" >&2
    exit 1
}

confirm() {
    gum confirm "$1"
}

cleanup_on_failure() {
    local status=${1:-$?}

    (( status != 0 )) || return 0
    [[ "$cleanup_enabled" == yes ]] || return 0

    if [[ -n "$temporary_esp_mount" ]]; then
        umount "$temporary_esp_mount" 2>/dev/null || true
        if ! findmnt -rn -M "$temporary_esp_mount" >/dev/null 2>&1; then
            rmdir "$temporary_esp_mount" 2>/dev/null || true
        fi
    fi
    if [[ "$mounted" == yes || "$top_mounted" == yes ]]; then
        umount -R /mnt 2>/dev/null || true
    fi
    if [[ "$opened_luks" == yes ]]; then
        cryptsetup close cryptroot 2>/dev/null || true
    fi
}
trap 'cleanup_on_failure "$?"' EXIT
trap 'exit 130' INT TERM

partition_path() {
    local disk=$1
    local number=$2

    if [[ "$disk" =~ [0-9]$ ]]; then
        printf '%sp%s\n' "$disk" "$number"
    else
        printf '%s%s\n' "$disk" "$number"
    fi
}

select_target() {
    local devices unlock

    if findmnt -rn /mnt >/dev/null 2>&1; then
        die '/mnt is already mounted. Unmount it first: umount -R /mnt'
    fi

    if [[ -e /dev/mapper/cryptroot ]]; then
        die '/dev/mapper/cryptroot already exists. Close it first: cryptsetup close cryptroot'
    fi

    show_section "System Disk"
    devices=$(lsblk --nodeps --paths --list --noheadings --sort=size --output=name,size,type,model | awk '$3 == "disk"')
    [[ -n "$devices" ]] || die 'No disks found.'

    target_disk=$(printf '%s\n' "$devices" | gum choose --header 'Select the disk your system is installed on:' | awk '{print $1}')
    efi_part=$(partition_path "$target_disk" 1)
    root_part=$(partition_path "$target_disk" 2)

    [[ -b "$efi_part" && -b "$root_part" ]] || die "Expected partitions $efi_part and $root_part not found on $target_disk."

    root_device="$root_part"
    if cryptsetup isLuks "$root_part"; then
        show_section "Unlock Root"
        unlock=$(gum choose --header "How do you want to unlock $root_part?" \
            'FIDO2 or TPM2 token (with PIN)' \
            'Passphrase or recovery key')
        if [[ "$unlock" == 'FIDO2 or TPM2 token (with PIN)' ]]; then
            show_action "ACTION REQUIRED: SECURITY TOKEN" \
                "Insert your FIDO2 key if you use one." \
                "The next prompt asks for your token PIN."
            cryptsetup open --token-only "$root_part" cryptroot
        else
            show_action "ACTION REQUIRED: LUKS UNLOCK" \
                "Enter a LUKS passphrase or recovery key at the next prompt."
            cryptsetup open --disable-external-tokens "$root_part" cryptroot
        fi
        opened_luks=yes
        root_device=/dev/mapper/cryptroot
    fi
}

mount_installed_system() {
    mount -o "$BTRFS_MOUNT_OPTIONS,subvol=@" "$root_device" /mnt
    mounted=yes

    chmod 0700 /mnt/root
    chmod 1777 /mnt/var/tmp

    if [[ -d /mnt/efi ]]; then
        mount -o "$EFI_MOUNT_OPTIONS" "$efi_part" /mnt/efi
    else
        show_warn '/mnt/efi does not exist; the ESP was not mounted.'
    fi

    # @sbctl holds the Secure Boot keys; without it no UKI can be signed.
    install -d -m 0755 /mnt/var/lib/sbctl
    if ! mount -o "$BTRFS_STRICT_MOUNT_OPTIONS,subvol=@sbctl" "$root_device" /mnt/var/lib/sbctl; then
        show_warn 'Could not mount @sbctl; UKI signing will be unavailable.'
    fi
}

mount_for_repair() {
    local -a next_steps

    select_target
    show_section "Repair Environment"
    mount_installed_system

    cleanup_enabled=no
    trap - INT TERM

    show_success "Installed system mounted at /mnt."
    next_steps=(
        "Enter the system:  arch-chroot /mnt"
        "Mount the rest:    mount -a"
        "Leave the chroot:  exit"
        "Unmount system:    umount -R /mnt"
    )
    if [[ "$opened_luks" == yes ]]; then
        next_steps+=("Close encryption:  cryptsetup close cryptroot")
    fi
    show_action "NEXT STEPS" "${next_steps[@]}"
}

check_package_integrity() {
    local mode result

    command -v trusted-paccheck >/dev/null 2>&1 || die 'trusted-paccheck is not available in this environment.'

    show_section "Package Integrity Check"
    mode=$(gum choose --header 'How should non-official (AUR/custom) packages be handled?' \
        'Strict: fail if any installed package is not an official Arch package' \
        'Official only: check official packages, report skipped foreign packages')

    select_target

    show_info 'Mounting the installed system read-only with rescue=nologreplay'
    mount -o "ro,rescue=nologreplay,$BTRFS_MOUNT_OPTIONS,subvol=@" "$root_device" /mnt
    mounted=yes

    result=0
    case "$mode" in
        Strict:*) trusted-paccheck || result=$? ;;
        *) trusted-paccheck --official-only || result=$? ;;
    esac

    umount /mnt
    mounted=no
    if [[ "$opened_luks" == yes ]]; then
        cryptsetup close cryptroot
        opened_luks=no
    fi

    if (( result == 0 )); then
        show_success 'Package integrity check passed.'
    else
        die "Package integrity check reported problems (exit $result). Review the output above."
    fi
}

list_snapshots() {
    local snapshot_dir entry info description

    snapshot_dir=/mnt/@snapshots
    [[ -d "$snapshot_dir" ]] || die '@snapshots was not found.'

    for entry in "$snapshot_dir"/*; do
        [[ -d "$entry/snapshot" ]] || continue
        description=''
        info="$entry/info.xml"
        if [[ -f "$info" ]]; then
            description=$(grep -m1 '<description>' "$info" | sed -E 's/.*<description>(.*)<\/description>.*/\1/' || true)
        fi
        printf '%s %s\n' "${entry##*/}" "$description"
    done | sort -n
}

subvolume_id() {
    btrfs inspect-internal rootid "$1"
}

default_subvolume_id() {
    btrfs subvolume get-default "$1" | awk '$1 == "ID" { print $2; exit }'
}

sign_and_verify_ukis() {
    local root=$1

    arch-chroot "$root" bash -lc 'command -v sbctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && [[ -d /var/lib/sbctl/keys ]]' || return 1
    arch-chroot "$root" sbctl sign -s /efi/EFI/Linux/arch-linux.efi || return 1
    verify_signed_file "$root" /efi/EFI/Linux/arch-linux.efi || return 1
    if [[ -f "$root/efi/EFI/Linux/arch-rescue.efi" ]]; then
        arch-chroot "$root" sbctl sign -s /efi/EFI/Linux/arch-rescue.efi || return 1
        verify_signed_file "$root" /efi/EFI/Linux/arch-rescue.efi || return 1
    fi
    if [[ -f "$root/usr/lib/fwupd/efi/fwupdx64.efi" ]]; then
        arch-chroot "$root" sbctl sign -s -o /usr/lib/fwupd/efi/fwupdx64.efi.signed /usr/lib/fwupd/efi/fwupdx64.efi || return 1
        verify_signed_file "$root" /usr/lib/fwupd/efi/fwupdx64.efi.signed || return 1
    fi
}

verify_signed_file() {
    local root=$1 file=$2 verification

    verification=$(arch-chroot "$root" sbctl --json verify "$file") || return 1
    arch-chroot "$root" jq -e 'length == 1 and .[0].is_signed == 1' <<<"$verification" >/dev/null
}

backup_boot_artifacts() {
    local esp=$1 backup_dir=$2

    [[ -s "$esp/EFI/Linux/arch-linux.efi" ]] || return 1
    install -m 0600 "$esp/EFI/Linux/arch-linux.efi" "$backup_dir/arch-linux.efi" || return 1
    if [[ -f "$esp/EFI/Linux/arch-rescue.efi" ]]; then
        install -m 0600 "$esp/EFI/Linux/arch-rescue.efi" "$backup_dir/arch-rescue.efi" || return 1
    fi
}

restore_boot_artifacts() {
    local esp=$1 backup_dir=$2

    install -m 0644 "$backup_dir/arch-linux.efi" "$esp/EFI/Linux/arch-linux.efi" || return 1
    sync -f "$esp/EFI/Linux/arch-linux.efi" || return 1
    if [[ -f "$backup_dir/arch-rescue.efi" ]]; then
        install -m 0644 "$backup_dir/arch-rescue.efi" "$esp/EFI/Linux/arch-rescue.efi" || return 1
        sync -f "$esp/EFI/Linux/arch-rescue.efi" || return 1
    fi
}

restore_boot_artifacts_from_device() {
    local backup_dir=$1
    local status=0

    temporary_esp_mount=$(mktemp -d /run/arch-rescue-esp.XXXXXX) || return 1
    if ! mount -o "$EFI_MOUNT_OPTIONS" "$efi_part" "$temporary_esp_mount"; then
        rmdir "$temporary_esp_mount"
        temporary_esp_mount=
        return 1
    fi
    restore_boot_artifacts "$temporary_esp_mount" "$backup_dir" || status=1
    if umount "$temporary_esp_mount"; then
        rmdir "$temporary_esp_mount" || status=1
        temporary_esp_mount=
    else
        status=1
    fi
    return "$status"
}

remove_boot_backup() {
    local backup_dir=$1

    rm -f "$backup_dir/arch-linux.efi" "$backup_dir/arch-rescue.efi"
    rmdir "$backup_dir"
}

rollback_promotion() {
    local old_root=$1 new_root=$2 failed_root=$3
    local old_root_id=$4 new_root_id=$5 original_default_id=$6 backup_dir=$7
    local current_root_id

    current_root_id=$(subvolume_id /mnt/@ 2>/dev/null || true)
    if [[ "$current_root_id" == "$new_root_id" ]]; then
        mv -T -- /mnt/@ "/mnt/$failed_root" || return 1
        current_root_id=
    elif [[ -n "$current_root_id" && "$current_root_id" != "$old_root_id" ]]; then
        return 1
    elif [[ -z "$current_root_id" && -e /mnt/@ ]]; then
        return 1
    fi

    if [[ -z "$current_root_id" ]]; then
        [[ ! -e /mnt/@ ]] || return 1
        [[ "$(subvolume_id "/mnt/$old_root" 2>/dev/null || true)" == "$old_root_id" ]] || return 1
        mv -T -- "/mnt/$old_root" /mnt/@ || return 1
    fi

    btrfs subvolume set-default "$original_default_id" /mnt || return 1
    [[ "$(subvolume_id /mnt/@ 2>/dev/null || true)" == "$old_root_id" ]] || return 1
    [[ "$(default_subvolume_id /mnt 2>/dev/null || true)" == "$original_default_id" ]] || return 1
    restore_boot_artifacts_from_device "$backup_dir"
}

replace_root_from_snapshot() {
    local snapshots selection snapshot old_root new_root failed_root timestamp
    local old_root_id new_root_id original_default_id candidate backup_dir
    local promotion_error

    select_target


    mount -o "$BTRFS_MOUNT_OPTIONS,subvolid=5" "$root_device" /mnt
    top_mounted=yes

    show_section "Choose Snapshot"
    snapshots=$(list_snapshots)
    [[ -n "$snapshots" ]] || die 'No Snapper snapshots found.'

    selection=$(printf '%s\n' "$snapshots" | gum choose --header 'Select the snapshot to restore as @:')
    snapshot=${selection%% *}
    [[ -d "/mnt/@snapshots/$snapshot/snapshot" ]] || die "Snapshot $snapshot is invalid."

    show_action "CONFIRM ROOT REPLACEMENT" \
        "Restore snapshot: $selection" \
        "The current root will be kept as an @old-* subvolume."
    confirm 'Replace the current root?' || die 'Root replacement cancelled.'

    timestamp=$(date +%Y%m%d-%H%M%S)
    old_root="@old-$timestamp"
    new_root="@new-rollback-$timestamp"
    failed_root="@failed-$timestamp"
    [[ -d /mnt/@ ]] || die 'Current root subvolume @ was not found.'
    [[ ! -e "/mnt/$old_root" && ! -e "/mnt/$new_root" && ! -e "/mnt/$failed_root" ]] || die 'Temporary rollback subvolume name already exists.'

    old_root_id=$(subvolume_id /mnt/@)
    original_default_id=$(default_subvolume_id /mnt)
    [[ "$old_root_id" =~ ^[0-9]+$ && "$original_default_id" =~ ^[0-9]+$ ]] || die 'Could not identify the current root and default subvolumes.'

    show_section "Restoring Root"
    show_info "Creating replacement from snapshot $snapshot"
    btrfs subvolume snapshot "/mnt/@snapshots/$snapshot/snapshot" "/mnt/$new_root"
    [[ -d "/mnt/$new_root" ]] || die 'Replacement root subvolume was not created.'
    candidate="/mnt/$new_root"
    new_root_id=$(subvolume_id "$candidate")
    [[ "$new_root_id" =~ ^[0-9]+$ ]] || die 'Could not identify the replacement root subvolume.'

    # snap-pac pre snapshots capture pacman's transaction lock. Nothing can
    # hold a lock inside a root that has never booted, so clear it now.
    rm -f "$candidate/var/lib/pacman/db.lck"

    [[ -d "$candidate/efi" && -d "$candidate/var/lib/sbctl" ]] || die 'Replacement root is missing required ESP or sbctl mount points.'
    arch-chroot "$candidate" bash -lc 'command -v mkinitcpio >/dev/null 2>&1 && command -v sbctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1' || \
        die 'Replacement root does not contain mkinitcpio, sbctl, and jq.'

    mount -o "$EFI_MOUNT_OPTIONS" "$efi_part" "$candidate/efi"
    mount -o "$BTRFS_STRICT_MOUNT_OPTIONS,subvol=@sbctl" "$root_device" "$candidate/var/lib/sbctl"
    [[ -d "$candidate/var/lib/sbctl/keys" ]] || die 'Secure Boot keys are unavailable in @sbctl.'

    backup_dir=$(mktemp -d /run/arch-rescue-uki.XXXXXX)
    backup_boot_artifacts "$candidate/efi" "$backup_dir" || die 'Could not back up the current UKIs before rebuilding them.'

    trap '' INT TERM
    show_info 'Rebuilding and signing UKIs before root promotion'
    if ! arch-chroot "$candidate" mkinitcpio -P || ! sign_and_verify_ukis "$candidate"; then
        if restore_boot_artifacts "$candidate/efi" "$backup_dir"; then
            remove_boot_backup "$backup_dir"
            die 'Could not prepare boot artifacts for the replacement root; the current UKIs were restored.'
        fi
        die "Could not prepare or restore boot artifacts. DO NOT REBOOT. UKI backups remain at $backup_dir."
    fi

    if ! umount "$candidate/var/lib/sbctl"; then
        restore_boot_artifacts "$candidate/efi" "$backup_dir" || \
            die "Could not unmount @sbctl or restore the current UKIs. DO NOT REBOOT. UKI backups remain at $backup_dir."
        remove_boot_backup "$backup_dir"
        die 'Could not unmount @sbctl; the current UKIs were restored.'
    fi
    if ! umount "$candidate/efi"; then
        if findmnt -rn -M "$candidate/efi" >/dev/null 2>&1; then
            restore_boot_artifacts "$candidate/efi" "$backup_dir" || \
                die "Could not unmount the ESP or restore the current UKIs. DO NOT REBOOT. UKI backups remain at $backup_dir."
        elif ! restore_boot_artifacts_from_device "$backup_dir"; then
            die "Could not verify the ESP unmount or restore the current UKIs. DO NOT REBOOT. UKI backups remain at $backup_dir."
        fi
        remove_boot_backup "$backup_dir"
        die 'Could not unmount the ESP; the current UKIs were restored.'
    fi

    promotion_error=
    if ! mv -T -- /mnt/@ "/mnt/$old_root"; then
        promotion_error='Could not retain the current root.'
    elif ! mv -T -- "/mnt/$new_root" /mnt/@; then
        promotion_error='Could not promote the replacement root.'
    elif ! btrfs subvolume set-default "$new_root_id" /mnt; then
        promotion_error='Could not set the replacement root as the default subvolume.'
    elif [[ "$(default_subvolume_id /mnt 2>/dev/null || true)" != "$new_root_id" ]]; then
        promotion_error='The replacement root was not confirmed as the default subvolume.'
    fi

    if [[ -n "$promotion_error" ]]; then
        if rollback_promotion "$old_root" "$new_root" "$failed_root" \
            "$old_root_id" "$new_root_id" "$original_default_id" "$backup_dir"; then
            remove_boot_backup "$backup_dir"
            die "$promotion_error The original root, default subvolume, and UKIs were restored."
        fi
        die "$promotion_error Automatic restoration failed. DO NOT REBOOT. Original root ID: $old_root_id; original default ID: $original_default_id; replacement root ID: $new_root_id; UKI backups: $backup_dir"
    fi
    trap 'exit 130' INT TERM
    remove_boot_backup "$backup_dir"

    umount -R /mnt
    top_mounted=no

    if [[ "$opened_luks" == yes ]]; then
        cryptsetup close cryptroot
        opened_luks=no
    fi

    show_success "Root restored from snapshot $snapshot."
    show_action "OLD ROOT RETAINED" \
        "$old_root" \
        "Keep it until the restored system is verified." \
        "Delete it later with Btrfs Assistant or btrfs subvolume delete."

    if confirm 'Reboot now?'; then
        systemctl reboot
    fi
}

if [[ ${EUID:-0} -ne 0 ]]; then
    die 'This script must be run as root.'
fi

show_header
show_section "Choose Rescue Action"
action=$(gum choose --header 'What do you need to do?' \
    'Repair installed system' \
    'Restore root from snapshot' \
    'Check package integrity')

case "$action" in
    'Repair installed system') mount_for_repair ;;
    'Restore root from snapshot') replace_root_from_snapshot ;;
    'Check package integrity') check_package_integrity ;;
esac
